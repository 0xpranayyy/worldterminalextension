{
  "manifest_version": 3,
  "name": "World Terminal — Market Scanner for world.xyz",
  "short_name": "World Terminal",
  "version": "0.3.0",
  "description": "Find the most liquid world.xyz prediction markets, spot arbitrage and closing favorites, and get price alerts.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "World Terminal",
    "default_popup": "src/ui/app.html"
  },
  "side_panel": {
    "default_path": "src/ui/app.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://world.xyz/*"
      ],
      "js": [
        "src/content/world.js"
      ],
      "css": [
        "src/content/world.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://world.xyz/*",
    "https://markets-api-proxy.world-xyz.workers.dev/*",
    "https://users-api.world.xyz/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Open World Terminal"
    }
  }
}
